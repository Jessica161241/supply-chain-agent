# 虚拟环境
.venv/
venv/
env/

# Python 缓存
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/

# 数据文件（raw 数据不进 Git）
# 注意：必须先排目录内容（/*）而不是整个目录，否则 git 不会进入该目录，
#       后面的 !.../.gitkeep 否定规则不会生效。
data/raw/*
data/processed/*
data/**/*.csv
data/**/*.parquet
!data/raw/.gitkeep
!data/processed/.gitkeep

# 框架源码备查产物（用 scripts/fetch_source.sh 随时可重建，不进 Git）
vendor/

# 系统文件
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/